{
  "name": "pace-line",
  "version": "0.3.1",
  "description": "Two-line status band for terminal and desktop: model, effort, context bar, git stats, and 5h/7d rate-limit pace",
  "author": { "name": "thaiquangquy" },
  "homepage": "https://github.com/thaiquangquy/claude.me/tree/master/mods/pace-line",
  "repository": "https://github.com/thaiquangquy/claude.me",
  "documentationUrl": "https://github.com/thaiquangquy/claude.me/blob/master/mods/pace-line/README.md",
  "supportUrl": "https://github.com/thaiquangquy/claude.me/issues",
  "privacyPolicyUrl": "https://github.com/thaiquangquy/claude.me/blob/master/mods/pace-line/PRIVACY.md",
  "termsOfServiceUrl": "https://github.com/thaiquangquy/claude.me/blob/master/mods/pace-line/TERMS.md",
  "license": "MIT",
  "icon": "./.claude-plugin/icon.png",
  "types": "./types/index.d.ts",
  "userConfig": {
    "surfaces": {
      "type": "string",
      "title": "Show the band on",
      "description": "Where pace-line draws: both, desktop (the Code tab only), or terminal",
      "options": [
        "both",
        "desktop",
        "terminal"
      ],
      "default": "both"
    },
    "showModel": {
      "type": "boolean",
      "title": "Show model, context window and effort",
      "description": "Off: line 1 shows only the project, branch and diff stats",
      "default": true
    }
  }
}
